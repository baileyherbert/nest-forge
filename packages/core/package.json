{
	"name": "@nest-forge/core",
	"description": "",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.json",
		"test": "npm run build && vitest run",
		"watch": "rimraf dist && tsc -w -p tsconfig.json",
		"format": "prettier --write \"{src,apps,libs,test}/**/*.ts\""
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"directories": {
		"lib": "src"
	},
	"files": [
		"dist",
		"tsconfig.json"
	],
	"keywords": [],
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/baileyherbert/nest-forge.git"
	},
	"bugs": {
		"url": "https://github.com/baileyherbert/nest-forge/issues"
	},
	"author": "Bailey Herbert <hello@bailey.sh>",
	"contributors": [],
	"dependencies": {
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@nestjs/testing": "^12.0.0-alpha.5",
		"@types/node": "~24.0.0",
		"prettier": "3.7.4",
		"rimraf": "^6.1.2",
		"typescript": "^5.9.0",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"@nestjs/common": "^12.0.0-alpha.5",
		"@nestjs/core": "^12.0.0-alpha.5",
		"@nestjs/testing": "^12.0.0-alpha.5",
		"reflect-metadata": "^0.2.1"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=10.0.0"
	}
}
